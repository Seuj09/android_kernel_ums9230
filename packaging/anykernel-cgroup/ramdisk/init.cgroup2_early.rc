# BOOT ramdisk early-init cgroup2 for A17 GSI (system/uid_*).
# Builtins are SoT (Debugger); shell fallback is best-effort during early-init only.

on early-init
    mkdir /sys/fs/cgroup 0755 root root
    mount cgroup2 none /sys/fs/cgroup nodev noexec nosuid
    write /sys/fs/cgroup/cgroup.subtree_control +cpuset +cpu +io +memory +pids
    mkdir /sys/fs/cgroup/apps 0755 system system
    mkdir /sys/fs/cgroup/system 0755 system system
    write /sys/fs/cgroup/apps/cgroup.subtree_control +cpuset +cpu +io +memory +pids
    write /sys/fs/cgroup/system/cgroup.subtree_control +cpuset +cpu +io +memory +pids

on early-init
    # Best-effort only — may 404 after switch_root; builtins above are the real path
    exec -- /system/bin/sh /cgroup2_early_fix.sh
